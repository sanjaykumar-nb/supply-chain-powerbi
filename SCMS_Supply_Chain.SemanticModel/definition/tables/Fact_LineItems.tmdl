table Fact_LineItems
	lineageTag: b3df6488-194b-5e67-b9bb-0378d17c4a78

	measure 'Line Items' = COUNTROWS ( Fact_LineItems )
		formatString: #,0
		lineageTag: 53fc434f-7a79-5aaa-9e41-c3914fb8903b

	measure 'Commodity Value (USD)' = SUM ( Fact_LineItems[Line Item Value] )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: b726fa71-15ac-5725-9d6d-c98750a4afc6

	measure 'Packs Delivered' = SUM ( Fact_LineItems[Line Item Quantity] )
		formatString: #,0
		lineageTag: 36b66210-ded3-507d-9353-ee981cd755b9

	measure 'Commodity Value Top 10 Countries' =
			VAR CountryRank =
			    RANKX ( ALLSELECTED ( Dim_Country[Country] ), [Commodity Value (USD)],, DESC )
			RETURN
			    IF ( CountryRank <= 10, [Commodity Value (USD)] )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: a3d24a55-7a00-567c-8119-7fa7c4154389

