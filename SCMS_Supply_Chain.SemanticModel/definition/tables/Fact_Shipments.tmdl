table Fact_Shipments
	lineageTag: 011e0fa7-4ebb-5e46-a6dd-65f153652a32

	measure Shipments = COUNTROWS ( Fact_Shipments )
		formatString: #,0
		lineageTag: 6ae5364f-91ff-567c-9e1f-4cf45f215c3f

	measure 'Late Shipments' = CALCULATE ( [Shipments], Fact_Shipments[Days vs Schedule] > 0 )
		formatString: #,0
		lineageTag: cf1ec64d-fbfe-5506-9185-026c09b3ec5c

	measure '% Late vs Schedule' = DIVIDE ( [Late Shipments] + 0, [Shipments] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 01f810df-bebc-5cc3-adb2-ad1e35d57c01

	measure 'Avg Days Late' =
			CALCULATE (
			    AVERAGE ( Fact_Shipments[Days vs Schedule] ),
			    Fact_Shipments[Days vs Schedule] > 0
			)
		formatString: #,0.0
		lineageTag: f50ce813-c816-5fda-a99e-d228f84f8c61

	measure 'Avg PO to Delivery Days' = AVERAGE ( Fact_Shipments[PO to Delivery Days] )
		formatString: #,0.0
		lineageTag: 5fea1efa-7aa0-5255-8bc6-aa68c1ecd1f7

	measure 'Median PO to Delivery Days' = MEDIAN ( Fact_Shipments[PO to Delivery Days] )
		formatString: #,0
		lineageTag: 6c5e1f4b-01ca-548a-9f54-0704f3280dd3

	measure 'Freight Cost (USD)' = SUM ( Fact_Shipments[Freight Cost USD] )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 58541c6c-1c81-57de-8167-a512075606d2

	measure 'Weight (kg)' = SUM ( Fact_Shipments[Weight kg] )
		formatString: #,0
		lineageTag: 74586d41-a546-5fec-8a75-a0f4c1039bfc

	measure 'Freight per kg (USD)' =
			DIVIDE (
			    CALCULATE ( SUM ( Fact_Shipments[Freight Cost USD] ), Fact_Shipments[Has Freight and Weight] = TRUE () ),
			    CALCULATE ( SUM ( Fact_Shipments[Weight kg] ), Fact_Shipments[Has Freight and Weight] = TRUE () )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 0b205d8e-3422-5a85-92f6-559d40b4daf2

	measure 'Freight % of Value' =
			DIVIDE (
			    [Freight Cost (USD)],
			    CALCULATE (
			        SUM ( Fact_Shipments[Shipment Value USD] ),
			        NOT ISBLANK ( Fact_Shipments[Freight Cost USD] )
			    )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: a73507b7-37a7-52a1-922f-937fa0db2b2b

	measure '% Freight Not Recorded' =
			DIVIDE (
			    CALCULATE ( [Shipments], Fact_Shipments[Freight Status] <> "Recorded" ),
			    [Shipments]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 8a5f907d-467f-5911-ab32-655ad156740a

	measure '% Weight Not Recorded' =
			DIVIDE (
			    CALCULATE ( [Shipments], Fact_Shipments[Weight Status] <> "Recorded" ),
			    [Shipments]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: faed9bf9-394c-52e5-a8de-b71aab0676ee

	measure '% Late (Vendors 50+ Shipments)' = IF ( [Shipments] >= 50, [% Late vs Schedule] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e37448bf-af8c-5f13-a7a1-e2e3fdc3a736

	measure '% Late (Countries 100+ Shipments)' = IF ( CALCULATE ( [Shipments], REMOVEFILTERS ( Dim_Date ) ) >= 100, [% Late vs Schedule] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: fe39ad33-4f04-5dd8-8a5a-475cd2eebee8

	measure 'Freight % of Value (Top 10 Freight Countries)' =
			VAR CountryRank =
			    RANKX ( ALLSELECTED ( Dim_Country[Country] ), [Freight Cost (USD)],, DESC )
			RETURN
			    IF ( CountryRank <= 10, [Freight % of Value] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 2d455071-4b80-5abd-9d22-6c5d86f7f619

